@inherits LayoutComponentBase

<header>
    <div class="header-brand">
        <h1>Leo's Record Shop</h1>
        <p>Welcome to Leo's Record shop</p>
    </div>
    <NavMenu />
</header>

<main>
    <RecordsProvider>
        @Body
    </RecordsProvider>
</main>

<footer>
    <p>Leo &copy; @DateTime.Now.Year</p>
</footer>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

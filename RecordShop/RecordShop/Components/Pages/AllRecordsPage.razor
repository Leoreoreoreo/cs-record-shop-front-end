@page "/records"
@rendermode InteractiveServer
@using System.Net.Http.Json

<h2>All Records</h2>

<div class="records-controls">
    <label>
        Sort by:
        <select @bind="sortBy" @bind:after="ApplySort">
            <option value="">Default</option>
            <option value="name">Name</option>
            <option value="artist">Artist</option>
            <option value="releaseYear">Release year</option>
            <option value="price">Price</option>
        </select>
    </label>
    <label>
        Order:
        <select @bind="order" @bind:after="ApplySort">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
        </select>
    </label>
</div>

@if (paged != null)
{
    <RecordsSummaryList Albums="paged.Albums" />

    <div class="pagination-controls">
        <button @onclick="PreviousPage" disabled="@(page <= 1)">Previous</button>
        <span>Page @paged.Page of @(paged.TotalPages == 0 ? 1 : paged.TotalPages)</span>
        <button @onclick="NextPage" disabled="@(page >= paged.TotalPages)">Next</button>
    </div>
}
else
{
    <p>Loading records...</p>
}

@code {
    private PagedAlbums? paged;
    private int page = 1;
    private const int pageSize = 4;
    private string sortBy = "";
    private string order = "asc";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var url = $"/api/albums?page={page}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(sortBy))
        {
            url += $"&sortBy={sortBy}&order={order}";
        }
        var http = new HttpClient { BaseAddress = new Uri(ApiConfig.BaseUrl) };
        paged = await http.GetFromJsonAsync<PagedAlbums>(url);
    }

    private async Task ApplySort()
    {
        page = 1;
        await Load();
    }

    private async Task NextPage()
    {
        if (paged != null && page < paged.TotalPages)
        {
            page++;
            await Load();
        }
    }

    private async Task PreviousPage()
    {
        if (page > 1)
        {
            page--;
            await Load();
        }
    }
}

@page "/"

<PageTitle>Leo's Record Shop</PageTitle>

<h2>Welcome to Leo's Record Shop</h2>
<p>Discover our collection of vinyl records. Browse all records or add your own.</p>
<a href="/records">Browse All Records</a>

@if (featured != null)
{
    <FeaturedRecord Album="featured" />
}

@code {
    [CascadingParameter]
    public List<Album>? Albums { get; set; }

    private Album? featured;

    protected override void OnParametersSet()
    {
        if (featured == null && Albums != null && Albums.Count > 0)
        {
            featured = Albums[new Random().Next(Albums.Count)];
        }
    }
}

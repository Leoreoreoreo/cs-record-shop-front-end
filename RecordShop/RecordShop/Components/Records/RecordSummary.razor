<a href="/records/@Album.Id" class="record-card-link">
<div class="record-card">
    <h3>@Album.Name</h3>
    <p>@Album.Artist</p>
    <p>@Album.Genre</p>
    <p>@Album.ReleaseYear</p>
    <p>£@Album.Price.ToString("0.00")</p>
</div>
</a>
@code
{
    [Parameter]
    public Album Album { get; set; }
}

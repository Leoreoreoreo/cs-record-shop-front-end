@rendermode InteractiveServer
@inject NavigationManager Nav


<EditForm Model="editableAlbum">
    <InputText @bind-Value="editableAlbum.Name" />
    <InputText @bind-Value="editableAlbum.Artist" />
    <InputText @bind-Value="editableAlbum.Genre" />
    <InputNumber @bind-Value="editableAlbum.ReleaseYear" />
    <InputNumber @bind-Value="editableAlbum.Price" />
    <InputNumber @bind-Value="editableAlbum.Stock" />
    <button type="button" @onclick="SaveChanges">Save Changes</button>
    <button @onclick="ConfirmDelete"><i class="bi bi-trash"></i></button>
</EditForm>

@if (updatedAlbum != null)
{
    <p>@updatedAlbum.Name</p>
    <p>@updatedAlbum.Artist</p>
    <p>@updatedAlbum.Genre</p>
    <p>@updatedAlbum.ReleaseYear</p>
    <p>£@updatedAlbum.Price.ToString("0.00")</p>
    <p>In stock: @updatedAlbum.Stock</p>
}
@if (saveMessage != null)
{
    <p>@saveMessage</p>
}
@if (showConfirm)
{
    <p>Confirm Delete?</p>
    <button @onclick="DeleteRecord">Confirm</button>
    <button @onclick="() => showConfirm = false">Cancel</button>
}
@if (deleteSuccess)
{
    <p>Record deleted successfully!</p>
}



@code {
    [Parameter]
    public Album? Album { get; set; }

    private Album editableAlbum = new Album();
    private Album? updatedAlbum = null;
    private string? saveMessage;
    private bool showConfirm = false;
    private bool deleteSuccess = false;


    protected override void OnParametersSet()
    {
        editableAlbum = new Album
        {
            Id = Album.Id,
            Name = Album.Name,
            Artist = Album.Artist,
            Genre = Album.Genre,
            ReleaseYear = Album.ReleaseYear,
            Price = Album.Price,
            Stock = Album.Stock
        };
    }

    private async Task SaveChanges()
    {
        updatedAlbum = new Album
        {
            Id = editableAlbum.Id,
            Name = editableAlbum.Name,
            Artist = editableAlbum.Artist,
            Genre = editableAlbum.Genre,
            ReleaseYear = editableAlbum.ReleaseYear,
            Price = editableAlbum.Price,
            Stock = editableAlbum.Stock
        };
        var http = new HttpClient { BaseAddress = new Uri(ApiConfig.BaseUrl) };
        var response = await http.PutAsJsonAsync($"/api/albums/{editableAlbum.Id}", editableAlbum);
        if (response.IsSuccessStatusCode)
        {
            saveMessage = "Changes saved!";
        }
        else
        {
            saveMessage = "Could not save changes. Please try again.";
        }
    }
    private void ConfirmDelete()
    {
        showConfirm = true;
    }
    private async Task DeleteRecord()
    {
        var http = new HttpClient{BaseAddress = new Uri(ApiConfig.BaseUrl)};
        await http.DeleteAsync($"/api/albums/{editableAlbum.Id}");
        deleteSuccess = true;
        StateHasChanged();
        await Task.Delay(1500);
        Nav.NavigateTo("/records");
    }
}
